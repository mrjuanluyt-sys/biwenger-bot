# --- Biwenger ---
# Opción A: cuenta con email/contraseña de Biwenger
BIWENGER_EMAIL=
BIWENGER_PASSWORD=

# Opción B: login con Google/Facebook/Apple (no hay contraseña).
# En biwenger.as.com logueado, F12 → Console:
#   localStorage.getItem('satellizer_token')
# Pega el token aquí (sin comillas).
BIWENGER_TOKEN=

# Si los dejas vacíos se resuelven solos tras el login.
# X-User es el id del EQUIPO en la liga, no el id de cuenta.
BIWENGER_LEAGUE_ID=
BIWENGER_USER_ID=

# Si ves error "Old version", súbelo. Se ve en las peticiones de la web (header X-Version)
# o en la URL del bundle: cdn.biwenger.com/app/vXXX/...
BIWENGER_APP_VERSION=631

# Competición. la-liga por defecto.
BIWENGER_COMPETITION=la-liga

# --- Telegram ---
# Crea un bot con @BotFather y pega el token.
TELEGRAM_BOT_TOKEN=
# Escribe /start a tu bot y mira el chat_id en los logs, o usa @userinfobot
TELEGRAM_CHAT_ID=

# --- Comportamiento ---
# true = solo simula escrituras (pujar/alinear/vender). Empieza así.
DRY_RUN=true

# Dinero que nunca se usa al calcular pujas.
BUDGET_SAFETY_MARGIN=1000000

# Hora del resumen diario (Europe/Madrid).
DAILY_BRIEFING_HOUR=10

# (Opcional) Análisis conversacional más fino con Grok.
# Sin esto el bot ya entiende español con el analizador propio.
XAI_API_KEY=
XAI_MODEL=grok-4.5
